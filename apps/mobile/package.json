{
  "name": "@entregas/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "expo": {
    "autolinking": {
      "android": { "buildFromSource": ["expo-location"] }
    }
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "prebuild:android": "expo prebuild --platform android --no-install",
    "build:android:release": "../../scripts/check-android-release-env.sh && expo prebuild --platform android --no-install && cd android && ./gradlew app:assembleRelease -PRELEASE_STORE_FILE=\"$RELEASE_STORE_FILE\" -PRELEASE_STORE_PASSWORD=\"$RELEASE_STORE_PASSWORD\" -PRELEASE_KEY_ALIAS=\"$RELEASE_KEY_ALIAS\" -PRELEASE_KEY_PASSWORD=\"$RELEASE_KEY_PASSWORD\"",
    "typecheck": "tsc --noEmit",
    "ios": "expo run:ios",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.1",
    "expo": "~54.0.0",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.14",
    "expo-crypto": "~15.0.9",
    "expo-device": "~8.0.0",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.0",
    "expo-image-picker": "~17.0.0",
    "expo-location": "~19.0.0",
    "expo-notifications": "~0.32.0",
    "expo-router": "~6.0.0",
    "expo-secure-store": "~15.0.0",
    "expo-sqlite": "~16.0.0",
    "expo-system-ui": "~6.0.9",
    "expo-task-manager": "~14.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "~19.1.0",
    "tsx": "4.23.15",
    "typescript": "~5.9.2"
  }
}
