HOST=127.0.0.1
PORT=3000
DATABASE_URL_AUTH=postgres://api_auth:local-auth-only@127.0.0.1:55432/entregas_dev
DATABASE_URL_TENANT=postgres://api_tenant:local-tenant-only@127.0.0.1:55432/entregas_dev
DATABASE_URL_PLATFORM=postgres://api_platform:local-platform-only@127.0.0.1:55432/entregas_dev
DATABASE_URL_WORKER=postgres://api_worker:local-worker-only@127.0.0.1:55432/entregas_dev
FILE_STORAGE_DIR=./private-files
CHECK_IN_MAX_DISTANCE_M=200
GPS_MAX_FUTURE_SKEW_SECONDS=300
GPS_MAX_AGE_DAYS=30
GPS_LOW_PRECISION_THRESHOLD_M=200
LOCATION_POLICY_VERSION=1.0.0
# Use somente fora do .env da aplicação, com uma credencial dedicada ao backup.
# BACKUP_DATABASE_URL=postgres://backup_user:...@db:5432/entregas
MFA_ENCRYPTION_KEY_HEX=replace-with-64-hex-characters
# Em produção, mantenha true e publique a API somente por HTTPS.
COOKIE_SECURE=false
FCM_PROJECT_ID=entrega-ja-mobile
GOOGLE_APPLICATION_CREDENTIALS=/home/yure/.config/entregaja/firebase-admin.json
